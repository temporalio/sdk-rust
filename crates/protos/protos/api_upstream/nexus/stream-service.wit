// Experimental. Might change in the future.
// The Stream service as a System Nexus service. Each record maps to a message under
// ../temporal/api (stream/v1, streamservice/v1 and the Stream enums in enums/v1). Each SDK copies
// this file and generates its Workflow API and its client from it with nexgen
// (`--targets workflow,client --system-nexus`).
package temporal:nexus@1.0.0;

world system {
  export stream-service;
}

/// @nexus.endpoint "__temporal_system"
/// @nexus.service-name "temporal.api.streamservice.v1.StreamService"
/// @nexus.experimental
interface stream-service {
  use nexus:temporal-types/model@1.0.0.{
    duration,
    placeholder,
  };

  /// The value type of a Stream's Records. A call's type argument sets it.
  /// @nexus.type-parameter
  type body-t = placeholder;

  // Every `list<u8>` offset in this file is the opaque position of a Record in one Stream (proto
  // `bytes`). A caller doesn't parse an offset. It passes one back to a read, or compares two
  // offsets of the same Stream, which compare bytewise in the order of their Records.
  // TODO: use `type stream-offset = list<u8>` once nexgen reads a named `list<u8>` as `bytes`.

  /// @nexus.proto "google.protobuf.Timestamp"
  record timestamp {
    seconds: s64,
    nanos: s32,
  }

  // A request sends only the id of its ref, through the `to` helper of its `ref` field. The SDK
  // reads the Store name from the ref to pick the Store of the call.
  /// @nexus.doc "A reference to one Stream. Callers treat the id as opaque."
  /// @nexus.proto "temporal.api.stream.v1.StreamRef"
  /// @nexus.generic "body-t"
  record stream-ref {
    /// @nexus.doc "The Stream id, 1 to 4096 bytes."
    id: string,
    /// @nexus.doc "The registered name of the Store. If empty, the SDK picks a Store."
    store: option<string>,
  }

  /// @nexus.doc "One attempt of a Workflow Task."
  /// @nexus.proto "temporal.api.stream.v1.WorkflowTaskAttempt"
  record workflow-task-attempt {
    started-event-id: s64,
    /// @nexus.doc "The attempt number of the task, starting at 1. Every task starts at 1 again."
    attempt: s32,
    /// @nexus.doc "When this attempt started. It distinguishes two tasks with one started id."
    started-time: option<timestamp>,
  }

  /// @nexus.doc "One attempt of a Local Activity. Attempts compare by Workflow Task first."
  /// @nexus.proto "temporal.api.stream.v1.LocalActivityAttempt"
  record local-activity-attempt {
    /// @nexus.doc "The Workflow Task attempt that dispatched the Local Activity."
    task: workflow-task-attempt,
    /// @nexus.doc "The Local Activity's own attempt number in that Workflow Task, from 1."
    attempt: s32,
  }

  /// @nexus.doc "One attempt of an Activity or a Standalone Activity."
  /// @nexus.proto "temporal.api.stream.v1.ActivityAttempt"
  record activity-attempt {
    /// @nexus.doc "When the server scheduled this attempt. It orders attempts across a reset."
    attempt-scheduled-time: timestamp,
    /// @nexus.doc "The attempt number, starting at 1. A reset starts it at 1 again."
    attempt: s32,
  }

  /// @nexus.doc "The Producer of a Workflow run."
  /// @nexus.proto "temporal.api.stream.v1.WorkflowProducer"
  record workflow-producer {
    namespace: string,
    workflow-id: string,
    /// @nexus.doc "The id of this run, not the first run id of its chain."
    run-id: string,
    // The Workflow Task attempt that makes the write.
    attempt: option<workflow-task-attempt>,
  }

  /// @nexus.doc "The Producer of one Local Activity of a Workflow run."
  /// @nexus.proto "temporal.api.stream.v1.LocalActivityProducer"
  record local-activity-producer {
    namespace: string,
    workflow-id: string,
    run-id: string,
    activity-id: string,
    attempt: local-activity-attempt,
  }

  /// @nexus.doc "The Producer of one Activity that a Workflow scheduled."
  /// @nexus.proto "temporal.api.stream.v1.WorkflowActivityProducer"
  record workflow-activity-producer {
    namespace: string,
    workflow-id: string,
    run-id: string,
    activity-id: string,
    attempt: activity-attempt,
  }

  /// @nexus.doc "The Producer of a Standalone Activity."
  /// @nexus.proto "temporal.api.stream.v1.StandaloneActivityProducer"
  record standalone-activity-producer {
    namespace: string,
    activity-id: string,
    /// @nexus.doc "The run id of the Activity itself."
    run-id: string,
    attempt: activity-attempt,
  }

  /// @nexus.doc "The Producer of a client. It has no run and no attempt."
  /// @nexus.proto "temporal.api.stream.v1.ClientProducer"
  record client-producer {
    namespace: string,
    /// @nexus.doc "The id of the client as a writer. The SDK makes one for each client object."
    id: string,
  }

  // Each kind is a separate case, so it has only its own ids. Two Producers are the same when
  // they have the same case and the same ids. The attempt isn't part of that.
  /// @nexus.doc "The writer of a batch. A later attempt supersedes an earlier one."
  /// @nexus.proto "temporal.api.stream.v1.Producer.kind"
  variant producer {
    workflow(workflow-producer),
    local-activity(local-activity-producer),
    workflow-activity(workflow-activity-producer),
    standalone-activity(standalone-activity-producer),
    client(client-producer),
  }

  /// @nexus.doc "One Record to append."
  /// @nexus.proto "temporal.api.stream.v1.AppendRecord"
  /// @nexus.flatten-in-api
  record append-record {
    /// @nexus.doc "The value."
    body: body-t,
  }

  // Offsets are unique and ordered within one Stream, but they have gaps, so they don't count
  // Records. A read returns only Records. A close stores no Record, so the read response reports
  // it with `done`.
  /// @nexus.doc "One Record of a Stream, as a read returns it."
  /// @nexus.proto "temporal.api.stream.v1.StreamRecord"
  record stream-record {
    /// @nexus.doc "The value."
    body: body-t,
    producer: option<producer>,
    /// @nexus.doc "The position of this Record in the Stream. Offsets are ordered, with gaps."
    offset: list<u8>,
  }

  /// @nexus.doc
  ///   "Create a Stream. If it already exists, fail, or return it with use-existing."
  /// @nexus.proto "temporal.api.streamservice.v1.CreateStreamRequest"
  record create-stream-request {
    /// @nexus.doc "The Stream to create. Its id must not be empty."
    /// @nexus.proto-field "stream_id"
    /// @nexus.type python-to="stream_ref_to_id" python-from="stream_ref_from_id"
    ///   typescript-to="streamRefToId" typescript-from="streamRefFromId"
    ///   dotnet-to="StreamSupport.RefToId" dotnet-from="StreamSupport.RefFromId"
    /// @nexus.flatten-in-api
    ref: stream-ref,
    /// @nexus.doc "What the create does if the Stream already exists. Unspecified means fail."
    id-conflict-policy: option<stream-id-conflict-policy>,
    // A retry of the create that made the Stream sends the same id, so it doesn't fail as a
    // conflict. In a Workflow the helper returns a deterministic id.
    /// @nexus.doc "Unique for each create call, and the same on its retries."
    /// @nexus.source python="request_id()" typescript="requestId()"
    ///   dotnet="StreamWorkflowContext.RequestId()"
    request-id: option<string>,
  }

  /// What a create does when its Stream exists. Unspecified is fail.
  /// @nexus.proto "temporal.api.enums.v1.StreamIdConflictPolicy"
  enum stream-id-conflict-policy {
    stream-id-conflict-policy-unspecified,
    stream-id-conflict-policy-fail,
    stream-id-conflict-policy-use-existing,
  }

  /// @nexus.proto "temporal.api.enums.v1.StreamStatus"
  enum stream-status {
    /// @nexus.fallback
    stream-status-unspecified,
    stream-status-open,
    stream-status-closed,
  }

  /// @nexus.doc "Append one batch. The Store writes a batch that arrives again only once."
  /// @nexus.proto "temporal.api.streamservice.v1.AppendRecordsRequest"
  record append-records-request {
    /// @nexus.proto-field "stream_id"
    /// @nexus.type python-to="stream_ref_to_id" python-from="stream_ref_from_id"
    ///   typescript-to="streamRefToId" typescript-from="streamRefFromId"
    ///   dotnet-to="StreamSupport.RefToId" dotnet-from="StreamSupport.RefFromId"
    ref: stream-ref,
    records: list<append-record>,
    // A call can pass its own Producer. Without one, the helper of the calling context returns
    // the default. The client helper gets the client of the Stream, so each client object is a
    // separate Producer.
    /// @nexus.doc "The Producer of the batch. Defaults to the Producer of the calling context."
    /// @nexus.default targets="workflow" python="_support.workflow_producer()"
    ///   typescript="support.workflowProducer()" dotnet="StreamWorkflowContext.Producer()"
    /// @nexus.default targets="client" python="_support.default_producer(self._nexus_client)"
    ///   typescript="support.defaultProducer()" dotnet="StreamActivityContext.Producer()"
    producer: producer,
    // A resend of a batch has the id of its first send, so the Store writes the batch once. For
    // Workflow code the helper returns nothing, and the SDK sets the id when it sends the batch.
    /// @nexus.doc "Unique for each append call, and the same on its retries."
    /// @nexus.source python="append_request_id()" typescript="appendRequestId()"
    ///   dotnet="StreamWorkflowContext.AppendRequestId()"
    request-id: option<string>,
  }

  /// @nexus.proto "temporal.api.streamservice.v1.AppendRecordsResponse"
  record append-records-response {
    first-offset: option<list<u8>>,
    last-offset: option<list<u8>>,
  }

  // A close has no value, so code with a final value appends it first.
  /// @nexus.doc "Close a Stream. Readers get the Records that are left. Later appends fail."
  /// @nexus.proto "temporal.api.streamservice.v1.CloseStreamRequest"
  record close-stream-request {
    /// @nexus.proto-field "stream_id"
    /// @nexus.type python-to="stream_ref_to_id" python-from="stream_ref_from_id"
    ///   typescript-to="streamRefToId" typescript-from="streamRefFromId"
    ///   dotnet-to="StreamSupport.RefToId" dotnet-from="StreamSupport.RefFromId"
    ref: stream-ref,
    /// @nexus.doc
    ///   "The Producer that closes the Stream. Defaults to the Producer of the calling context."
    /// @nexus.default targets="workflow" python="_support.workflow_producer()"
    ///   typescript="support.workflowProducer()" dotnet="StreamWorkflowContext.Producer()"
    /// @nexus.default targets="client" python="_support.default_producer(self._nexus_client)"
    ///   typescript="support.defaultProducer()" dotnet="StreamActivityContext.Producer()"
    producer: producer,
  }

  /// @nexus.proto "temporal.api.streamservice.v1.CloseStreamResponse"
  record close-stream-response {
  }

  /// @nexus.doc "Read Records after an offset."
  /// @nexus.proto "temporal.api.streamservice.v1.ReadRecordsRequest"
  record read-records-request {
    /// @nexus.proto-field "stream_id"
    /// @nexus.type python-to="stream_ref_to_id" python-from="stream_ref_from_id"
    ///   typescript-to="streamRefToId" typescript-from="streamRefFromId"
    ///   dotnet-to="StreamSupport.RefToId" dotnet-from="StreamSupport.RefFromId"
    ref: stream-ref,
    // To read only new Records, a caller gets last-offset from a describe and reads after it.
    /// @nexus.doc "Read after this offset. Empty means from the beginning."
    from-offset: option<list<u8>>,
    /// @nexus.doc "The maximum number of Records in one page."
    max-records: option<s32>,
    /// @nexus.doc "The maximum bytes of Records in a page. A larger Record is returned alone."
    max-bytes: option<s64>,
    /// @nexus.doc "How long to wait for a new Record before the read returns an empty page."
    wait: option<duration>,
  }

  /// @nexus.proto "temporal.api.streamservice.v1.ReadRecordsResponse"
  record read-records-response {
    records: list<stream-record>,
    /// @nexus.doc "The offset of the last Record in this page. The next read starts after it."
    last-offset: option<list<u8>>,
    /// @nexus.doc "True when the Stream is closed and this page has its last Record."
    done: bool,
  }

  /// @nexus.proto "temporal.api.streamservice.v1.DescribeStreamRequest"
  record describe-stream-request {
    /// @nexus.proto-field "stream_id"
    /// @nexus.type python-to="stream_ref_to_id" python-from="stream_ref_from_id"
    ///   typescript-to="streamRefToId" typescript-from="streamRefFromId"
    ///   dotnet-to="StreamSupport.RefToId" dotnet-from="StreamSupport.RefFromId"
    ref: stream-ref,
  }

  /// @nexus.proto "temporal.api.streamservice.v1.DescribeStreamResponse"
  record describe-stream-response {
    status: option<stream-status>,
    /// @nexus.doc "The offset of the newest Record. Empty when the Stream has none."
    last-offset: option<list<u8>>,
  }

  // A stream object is immutable, because its methods return offsets as values. Only the response
  // of a create sets `created`, so a stream built from a ref has none.
  /// @nexus.doc "One Stream. Build it from a stream-ref, or get it from a create."
  // TODO: implement @nexus.flatten-in-api param="ref".
  resource %stream {
    constructor(ref: stream-ref, created: option<bool>);

    /// @nexus.doc "Append values, and return the offsets of the batch."
    /// @nexus.operation "append-records"
    /// @nexus.varargs "records"
    append: func(
      records: list<append-record>,
      producer: option<producer>,
    ) -> append-records-response;

    /// @nexus.doc "Close the Stream. Readers get the Records that are left, then end."
    /// @nexus.operation "close-stream"
    /// @nexus.close
    close: func(producer: option<producer>);

    // Workflow code and a client read the same way, with a page read or its poll iterator.
    /// @nexus.doc "Read one page of Records. The poll iterator reads them all."
    /// @nexus.operation "read-records"
    read: func(
      from-offset: option<list<u8>>,
      max-records: option<s32>,
      wait: option<duration>,
      max-bytes: option<s64>,
    ) -> read-records-response;

    /// @nexus.doc "Return the status and the newest offset of the Stream."
    /// @nexus.operation "describe-stream"
    describe: func() -> describe-stream-response;
  }

  // With use-existing, created is false when the Stream existed.
  /// @nexus.proto "temporal.api.streamservice.v1.CreateStreamResponse"
  type create-stream-result = own<%stream>;

  // The Workflow API has no other way to create a Stream, so this function stays public.
  /// @nexus.operation name="CreateStream"
  /// @nexus.resource-binding ref="request.ref" created="result.created"
  create-stream: func(request: create-stream-request) -> create-stream-result;

  /// @nexus.doc "Append one batch. For Workflow code, Core makes the call."
  /// @nexus.operation name="AppendRecords"
  /// @nexus.api-omit
  append-records: func(request: append-records-request) -> append-records-response;

  /// @nexus.operation name="CloseStream"
  /// @nexus.api-omit
  close-stream: func(request: close-stream-request) -> close-stream-response;

  // A WIT stream can't cross a Nexus call, so a read is a request and a response. The SDK's support
  // helper builds the next request from a page for the poll iterator.
  /// @nexus.doc "A long poll. It fails with NOT_FOUND for a Stream that was never created."
  /// @nexus.operation name="ReadRecords"
  /// @nexus.poll python="next_read_request" items="records" python-resume="resume_read_request"
  /// @nexus.api-omit
  // TODO: implement polling for typescript="nextReadRequest" dotnet="StreamPoll.NextReadRequest".
  read-records: func(request: read-records-request) -> read-records-response;

  /// @nexus.operation name="DescribeStream"
  /// @nexus.api-omit
  describe-stream: func(request: describe-stream-request) -> describe-stream-response;

}
